table Year

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column has_aqi_data
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: has_aqi_data

	partition Year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Typed columns" = Table.TransformColumnTypes(
				        #"Promoted headers",
				        {
						{"date", type date},
						{"year", Int64.Type},
						{"month", Int64.Type},
						{"month_name", type text},
						{"month_start", type date},
						{"quarter", Int64.Type},
						{"weekday_no", Int64.Type},
						{"weekday_name", type text},
						{"is_weekend", type logical},
						{"season", type text},
						{"season_order", Int64.Type},
						{"is_oct_nov", type logical}
				        },
				        "en-US"
				    ),
				    Years = Table.Distinct(Table.SelectColumns(#"Typed columns", {"year"})),
				    AqiSource = Csv.Document(File.Contents(DataFolder & "mart_city_daily_aqi.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    AqiTyped = Table.TransformColumnTypes(Table.PromoteHeaders(AqiSource, [PromoteAllScalars = true]), {{"date", type date}}, "en-US"),
				    AqiYears = List.Distinct(List.Transform(AqiTyped[date], each Date.Year(_))),
				    Flagged = Table.AddColumn(Years, "has_aqi_data", each List.Contains(AqiYears, [year]), type logical),
				    Sorted = Table.Sort(Flagged, {{"year", Order.Ascending}})
				in
				    Sorted
